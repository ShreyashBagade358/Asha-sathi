# =============================================================================
# ASHA Sathi - environment configuration (root)
# Copy to .env and fill in real values. NEVER commit .env files.
# =============================================================================

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://asha:asha_dev@localhost:5432/asha_sathi
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=CHANGE_ME_JWT_SECRET_4a1f9c3e7b2d8f5a1c3e7b2d8f5a1c3e
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_V1_PREFIX=/api/v1
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Supabase (optional; Supabase Cloud or local compose profile) ---
SUPABASE_URL=http://localhost:18000
SUPABASE_ANON_KEY=CHANGE_ME_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=CHANGE_ME_SUPABASE_SERVICE_KEY
SUPABASE_JWT_SECRET=CHANGE_ME_JWT_SECRET_4a1f9c3e7b2d8f5a1c3e7b2d8f5a1c3e
SUPABASE_REALTIME_SECRET=CHANGE_ME_realtime_secret_base_0123456789012345

# --- Dashboard ---
VITE_API_URL=http://localhost:8000/api/v1

# --- SMS / push (optional) ---
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FCM_SERVER_KEY=

# --- ABDM (optional) ---
ABDM_CLIENT_ID=CHANGE_ME_ABDM_CLIENT_ID
ABDM_CLIENT_SECRET=CHANGE_ME_ABDM_CLIENT_SECRET
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_GATEWAY_URL=https://dev.gateway.abdm.gov.in

# --- ML ---
ML_MODEL_DIR=./models
MODEL_REGISTRY_PATH=

# --- Observability ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# --- Deployment ---
IMAGE_TAG=latest
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
