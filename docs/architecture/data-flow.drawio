        <mxCell id="mobile" value="Mobile Apps&#10;(Flutter: ASHA / Patient / PHC Admin)&#10;offline-first + sync" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
