{
  "expo": {
    "name": "ASHA Sathi",
    "slug": "asha-sathi-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ashasathi",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.ashasathi.mobile"
    },
    "android": {
      "package": "org.ashasathi.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0F766E"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F766E",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
