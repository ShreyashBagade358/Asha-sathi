# Metro (Expo's bundler) resolves modules by walking node_modules the way npm
# lays it out, so it needs a flat tree. pnpm's default isolated store hides
# transitive dependencies (query-string, @babel/runtime, ...) and the bundle
# fails to resolve them.
#
# This is scoped to this package only - the web dashboard keeps the default
# strict pnpm layout.
node-linker=hoisted
