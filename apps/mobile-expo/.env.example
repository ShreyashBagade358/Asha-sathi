# API base URL for the FastAPI backend.
#
# Local development — a physical device cannot reach `localhost`, so use your
# machine's LAN address instead:
#
#   macOS:   ipconfig getifaddr en0
#   Linux:   hostname -I
#
# Production (deployed backend on Render):
#
#   EXPO_PUBLIC_API_URL=https://asha-sathi-api.onrender.com/api/v1
#
# Keep the /api/v1 suffix; the client appends paths like /auth/otp/send.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api/v1
