# API base URL for the FastAPI backend.
#
# A physical device cannot reach your machine on `localhost` - from the phone,
# `localhost` means the phone itself. Use your machine's LAN address instead:
#
#   macOS:   ipconfig getifaddr en0
#   Linux:   hostname -I
#
# Keep the /api/v1 suffix; the client appends paths like /auth/otp/send.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api/v1
