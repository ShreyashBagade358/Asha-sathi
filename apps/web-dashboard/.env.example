# REST API base URL. In production the nginx reverse proxy exposes /api, so
# the app can run without setting VITE_API_URL (falls back to "/api/v1").
VITE_API_URL=http://localhost:8000/api/v1

# Supabase project URL + anon key (realtime + auth fallback).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
