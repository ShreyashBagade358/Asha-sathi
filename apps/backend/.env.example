# ASHA Sathi API - environment configuration
APP_NAME=ASHA Sathi API
APP_ENV=dev
API_V1_PREFIX=/api/v1
DEBUG=false

# Database (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://asha:asha@localhost:5432/asha_sathi

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=5

# Redis / Celery
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# FCM
FCM_SERVER_KEY=

# Twilio
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ABDM
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_GATEWAY_URL=https://dev.gateway.abdm.gov.in

# ML model registry
MODEL_REGISTRY_PATH=
